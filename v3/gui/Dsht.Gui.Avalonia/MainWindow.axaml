<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Dsht.Gui.Avalonia.MainWindow"
        Title="DeepSeek Harness Toolkit — 布局框架对比"
        Width="1280" Height="820"
        MinWidth="1000" MinHeight="600"
        Background="#F3F4F6">
  <Grid RowDefinitions="Auto,Auto,*">
    <Border Grid.Row="0" Background="#4D6BFE" Padding="16,10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
          <TextBlock Text="◆" Foreground="White" FontSize="16" VerticalAlignment="Center" />
          <TextBlock Text="DeepSeek Harness Toolkit" Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
          <Border Background="#3A55D9" CornerRadius="9" Padding="7,2" VerticalAlignment="Center">
            <TextBlock Text="布局框架对比 · 本地预览" Foreground="White" FontSize="11" />
          </Border>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="⚠ 非官方 · 只读本地状态 · 不联网" Foreground="#DCE4FF" FontSize="12" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="White" BorderThickness="0,0,0,1" BorderBrush="#E5E7EB" Padding="16,8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="布局框架" Foreground="#6B7280" FontSize="12" VerticalAlignment="Center" />
        <Button x:Name="Shell0" Content="① 侧栏式" />
        <Button x:Name="Shell1" Content="② 顶部标签式" />
        <Button x:Name="Shell2" Content="③ 卡片网格仪表盘" />
        <Button x:Name="Shell3" Content="④ 主从式（列表+详情）" />
        <TextBlock x:Name="ShellHint" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" Text="" />
      </StackPanel>
    </Border>
    <ContentControl Grid.Row="2" x:Name="Body" />
  </Grid>
</Window>