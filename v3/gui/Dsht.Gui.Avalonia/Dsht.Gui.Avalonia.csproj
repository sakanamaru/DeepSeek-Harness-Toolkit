<Project Sdk="Microsoft.NET.Sdk">
  <!--
    V3 跨平台 GUI（Avalonia）—— **骨架**，与 v2.x 的 WinForms GUI 并行存在。
    架构约定（V3.0 方案 §7.3/§7.5）：
      · GUI 只是"呈现适配器"：所有逻辑在 V3 CLI 的标记行契约后面，GUI 不引用核心程序集，只调 CLI。
      · 因此这里没有 ProjectReference —— 换 UI 不影响核心，换核心也不影响 UI。
      · GUI 层允许第三方 UI 库（用户已批准）；Core/CLI 仍严格零第三方依赖。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>dsht-gui</AssemblyName>
    <!-- 窗口/任务栏图标 ✓（用户实测：GUI 的图标是占位符 ✗ 加上这个就对了 ✓） -->
    <ApplicationIcon>Assets\logo-icon.ico</ApplicationIcon>
    <RootNamespace>Dsht.Gui.Avalonia</RootNamespace>
    <!-- Avalonia 自带 DPI 处理，不需要 Win32 清单 -->

    <!--
      ★ 体积（2026-10 实测）：GUI 是三个发布物里最大的一块 —— 自包含目录未压缩约 100 MB / 225 个文件，
      占 Windows 包（74 MB zip）的 60% 以上。开裁剪后 GUI 的 zip 从 43.7 MB 降到 19.3 MB（-56%），
      整个包 74 MB → 约 50 MB（-33%）。

      为什么这个项目敢开：本 GUI 的界面**全部由 C# 构建**（Shells/Shells.cs），两个 .axaml 只声明
      具名元素与 FluentTheme，**零 {Binding} / ReflectionBinding / Behaviors** —— 没有反射式绑定可被裁掉，
      而"反射式绑定被裁掉"正是 Avalonia 裁剪最常见的翻车点。

      只开 partial 不开 full：full 会连框架里带反射的路径一起裁，收益不成比例、风险大得多。
      也刻意**不做** PublishSingleFile：实测单文件+压缩只再多省 3.5 MB（zip 43.7 → 40.2 MB），
      代价是首次运行要往临时目录解包原生库 —— 不划算。

      ⚠️ 裁剪失败**只在运行时暴露**（构建通过 ≠ 能跑）→ 改这个开关后必须真机开一次 GUI 才算验证过。
    -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <!--
    ★★ 架构审计抓到（S4）：GUI 里把领域层的 MarkerText **逐字复制**了一份 ✗
      → 两边靠"人记得同步" ✗ → 改一边就悄悄不一致（标题里带空格/百分号就会解析错 ✗）
    ✓ 现在：**把同一份源码链进来编译** ✓✓（仍然**没有 ProjectReference** ✓
      架构约定不破 ✓ 只是共享一个纯函数文件 ✓）
  -->
  <ItemGroup>
    <Compile Include="..\..\src\Dsht.Domain\Services\MarkerText.cs" Link="MarkerText.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.1" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.1" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="FluentIcons.Avalonia" Version="1.1.265" />
    <!--
      ★ 已删除 Avalonia.Xaml.Behaviors：全仓库搜 Interaction.Behaviors / xmlns:behaviors 只有这一行引用，
      即**声明了却从未使用**。删掉它同时去掉一份反射式的行为库（对裁剪也更安全）。
    -->
  </ItemGroup>
</Project>
