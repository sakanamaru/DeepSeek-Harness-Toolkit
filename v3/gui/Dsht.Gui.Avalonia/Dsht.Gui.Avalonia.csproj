<Project Sdk="Microsoft.NET.Sdk">
  <!--
    V3 跨平台 GUI（Avalonia）—— **骨架**，与 v2.x 的 WinForms GUI 并行存在。
    架构约定（V3.0 方案 §7.3/§7.5）：
      · GUI 只是"呈现适配器"：所有逻辑在 V3 CLI 的标记行契约后面，GUI 不引用核心程序集，只调 CLI。
      · 因此这里没有 ProjectReference —— 换 UI 不影响核心，换核心也不影响 UI。
      · GUI 层允许第三方 UI 库（用户已批准）；Core/CLI 仍严格零第三方依赖。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>dsht-gui</AssemblyName>
    <!-- 窗口/任务栏图标 ✓（用户实测：GUI 的图标是占位符 ✗ 加上这个就对了 ✓） -->
    <ApplicationIcon>Assets\logo-icon.ico</ApplicationIcon>
    <RootNamespace>Dsht.Gui.Avalonia</RootNamespace>
    <!-- Avalonia 自带 DPI 处理，不需要 Win32 清单 -->
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <!--
    ★★ 架构审计抓到（S4）：GUI 里把领域层的 MarkerText **逐字复制**了一份 ✗
      → 两边靠"人记得同步" ✗ → 改一边就悄悄不一致（标题里带空格/百分号就会解析错 ✗）
    ✓ 现在：**把同一份源码链进来编译** ✓✓（仍然**没有 ProjectReference** ✓
      架构约定不破 ✓ 只是共享一个纯函数文件 ✓）
  -->
  <ItemGroup>
    <Compile Include="..\..\src\Dsht.Domain\Services\MarkerText.cs" Link="MarkerText.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.1" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.1" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="FluentIcons.Avalonia" Version="1.1.265" />
    <PackageReference Include="Avalonia.Xaml.Behaviors" Version="11.2.0.1" />
  </ItemGroup>
</Project>
